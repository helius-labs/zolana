[workspace]
resolver = "2"
members = ["program", "cli"]

[workspace.package]
edition = "2021"

# The ring's behavior lives in the zolana checkout the wizard was run from. Point
# both at a git revision to build without the checkout.
[workspace.dependencies]
custom-ring-program = { path = "{{zolana_path}}/custom-rings/program" }
custom-ring-cli = { path = "{{zolana_path}}/custom-rings/cli" }
anyhow = "1.0"
pinocchio = "0.11"

[profile.release]
overflow-checks = true
lto = "fat"
codegen-units = 1
