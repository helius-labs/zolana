[workspace]
resolver = "2"
members = ["program", "cli"]

[workspace.package]
edition = "2021"

# The ring's behavior lives in the zolana source at `zolana_path`, `just source`
# pins it to the recorded revision.
[workspace.dependencies]
anyhow = "1.0"
clap = { version = "4.5", features = ["derive"] }
hex = "0.4"
pinocchio = "0.11"
custom-ring-program = { path = "{{zolana_path}}/custom-rings/program" }
custom-ring-cli = { path = "{{zolana_path}}/custom-rings/cli" }
zolana-ring-rpc = { path = "{{zolana_path}}/services/ring-rpc" }

[profile.release]
overflow-checks = true
lto = "fat"
codegen-units = 1
