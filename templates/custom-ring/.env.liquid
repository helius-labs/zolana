# Secrets and local settings the ring reads. Not committed.
HELIUS_API_KEY={{helius_api_key}}
# Browser origins the ring RPC answers, comma separated. Passkey reads need it.
RING_RPC_ALLOW_ORIGINS=http://localhost:3000
RING_RPC_WEBAUTHN_RP_ID=localhost
# The prover queue the audit proof goes through, `just localnet` and `just transact` need it.
ZOLANA_PROVER_REDIS_URL=redis://127.0.0.1:6379/0
