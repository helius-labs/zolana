[package]
name = "{{project-name}}-program"
version = "0.1.0"
edition.workspace = true
publish = false

[lib]
crate-type = ["cdylib", "lib"]

[features]
default = []
bpf-entrypoint = []

[dependencies]
custom-ring-program = { workspace = true, features = ["no-entrypoint"{% if cargo_features != "" %}, {{cargo_features}}{% endif %}] }
pinocchio.workspace = true

[lints.rust.unexpected_cfgs]
level = "warn"
check-cfg = ['cfg(target_os, values("solana"))']
