[package]
name = "{{project-name}}"
version = "0.1.0"
edition.workspace = true
publish = false
default-run = "{{project-name}}"

[[bin]]
name = "{{project-name}}"
path = "src/main.rs"

[[bin]]
name = "auditor-pubkey"
path = "src/auditor_pubkey.rs"
required-features = ["auditor-key"]

[features]
auditor-key = ["dep:zolana-ring-client", "dep:clap", "dep:hex"]

[dependencies]
anyhow = { workspace = true }
custom-ring-cli = { workspace = true{% if cargo_features != "" %}, features = [{{cargo_features}}]{% endif %} }
clap = { workspace = true, optional = true }
hex = { workspace = true, optional = true }
zolana-ring-client = { workspace = true, optional = true }
