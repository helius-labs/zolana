{
  "name": "@zolana/client",
  "version": "0.1.0",
  "description": "Zolana RPC, indexer, prover, transaction assembly, and confirmation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/zolana.git",
    "directory": "sdk-libs/ts/client"
  },
  "homepage": "https://github.com/helius-labs/zolana/tree/main/sdk-libs/ts/client",
  "bugs": {
    "url": "https://github.com/helius-labs/zolana/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "browserslist": [
    "chrome >= 94",
    "edge >= 94",
    "firefox >= 93",
    "safari >= 16.4",
    "ios >= 16.4"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    },
    "./prover": {
      "browser": {
        "types": "./dist/es/prover/index.d.ts",
        "default": "./dist/es/prover/index.js"
      },
      "import": {
        "types": "./dist/es/prover/index.d.ts",
        "default": "./dist/es/prover/index.js"
      },
      "require": {
        "types": "./dist/cjs/prover/index.d.ts",
        "default": "./dist/cjs/prover/index.js"
      },
      "default": "./dist/es/prover/index.js"
    },
    "./retry": {
      "browser": {
        "types": "./dist/es/retry/index.d.ts",
        "default": "./dist/es/retry/index.js"
      },
      "import": {
        "types": "./dist/es/retry/index.d.ts",
        "default": "./dist/es/retry/index.js"
      },
      "require": {
        "types": "./dist/cjs/retry/index.d.ts",
        "default": "./dist/cjs/retry/index.js"
      },
      "default": "./dist/es/retry/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@zolana/api": "0.1.0",
    "@zolana/hasher": "0.1.0",
    "@zolana/indexer-api": "0.1.0",
    "@zolana/interface": "0.1.0",
    "@zolana/keypair": "0.1.0",
    "@zolana/transaction": "0.1.0"
  },
  "scripts": {
    "build": "node ../config/build.mjs client",
    "typecheck": "node ../config/typecheck.mjs client",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:vectors": "vitest run --config ../config/vitest.vectors.config.js",
    "test:property": "vitest run --config ../config/vitest.property.config.js",
    "test:cross": "vitest run --config ../config/vitest.package.config.js test/indexer-client.test.ts test/solana-rpc.test.ts",
    "test:prover": "vitest run --config ../config/vitest.package.config.js test/prover.test.ts",
    "test:p4": "ZOLANA_TEST_P4= ZOLANA_TEST_P4_FULL= vitest run --config ../config/vitest.vectors.config.js test/vectors/cryptographic-verification.test.ts",
    "test:p4:live": "ZOLANA_TEST_P4=1 ZOLANA_TEST_P4_FULL= vitest run --config ../config/vitest.vectors.config.js test/vectors/cryptographic-verification.test.ts",
    "test:p4:full": "ZOLANA_TEST_P4=1 ZOLANA_TEST_P4_FULL=1 vitest run --config ../config/vitest.vectors.config.js test/vectors/cryptographic-verification.test.ts",
    "test:p5:g2": "ZOLANA_TEST_P5=1 vitest run --config ../config/vitest.vectors.config.js test/vectors/g2-compression-live.test.ts",
    "test:browser": "node ../config/browser-check.mjs client",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
