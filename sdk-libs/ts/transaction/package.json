{
  "name": "@zolana/transaction",
  "version": "0.1.0",
  "description": "Deterministic Zolana transaction construction and private wallet state.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/zolana.git",
    "directory": "sdk-libs/ts/transaction"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./serialization": {
      "types": "./dist/serialization/index.d.ts",
      "browser": "./dist/serialization/index.js",
      "import": "./dist/serialization/index.js",
      "default": "./dist/serialization/index.js"
    },
    "./instructions": {
      "types": "./dist/instructions/index.d.ts",
      "browser": "./dist/instructions/index.js",
      "import": "./dist/instructions/index.js",
      "default": "./dist/instructions/index.js"
    },
    "./transact": {
      "types": "./dist/transact/index.d.ts",
      "browser": "./dist/transact/index.js",
      "import": "./dist/transact/index.js",
      "default": "./dist/transact/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "browser": "./dist/wallet/index.js",
      "import": "./dist/wallet/index.js",
      "default": "./dist/wallet/index.js"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@zolana/interface": "0.1.0",
    "@zolana/keypair": "0.1.0"
  },
  "scripts": {
    "build": "node ../config/build.mjs transaction",
    "typecheck": "node ../config/typecheck.mjs transaction",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:vectors": "vitest run --config ../config/vitest.vectors.config.js",
    "test:property": "vitest run --config ../config/vitest.property.config.js",
    "test:browser": "node ../config/browser-check.mjs transaction",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
