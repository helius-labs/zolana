{
  "name": "@helius/zolana",
  "version": "0.1.0",
  "description": "Umbrella re-exports of the Zolana TypeScript app surface.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/zolana.git",
    "directory": "sdk-libs/ts/zolana"
  },
  "homepage": "https://github.com/helius-labs/zolana/tree/main/sdk-libs/ts/zolana",
  "bugs": {
    "url": "https://github.com/helius-labs/zolana/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "browserslist": [
    "chrome >= 94",
    "edge >= 94",
    "firefox >= 93",
    "safari >= 16.4",
    "ios >= 16.4"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    },
    "./kit": {
      "browser": {
        "types": "./dist/es/kit/index.d.ts",
        "default": "./dist/es/kit/index.js"
      },
      "import": {
        "types": "./dist/es/kit/index.d.ts",
        "default": "./dist/es/kit/index.js"
      },
      "require": {
        "types": "./dist/cjs/kit/index.d.ts",
        "default": "./dist/cjs/kit/index.js"
      },
      "default": "./dist/es/kit/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "dependencies": {
    "@zolana/client": "0.1.0",
    "@zolana/interface": "0.1.0",
    "@zolana/keypair": "0.1.0",
    "@zolana/kit": "0.1.0",
    "@zolana/transaction": "0.1.0",
    "@zolana/wallet": "0.1.0"
  },
  "scripts": {
    "build": "node ../config/build.mjs zolana",
    "typecheck": "node ../config/typecheck.mjs zolana",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:browser": "node ../config/browser-check.mjs zolana",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
