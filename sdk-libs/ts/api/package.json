{
  "name": "@zolana/api",
  "version": "0.1.0",
  "description": "Browser-safe transport for the Zolana indexer API.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "dependencies": {
    "@zolana/indexer-api": "0.1.0",
    "@zolana/interface": "0.1.0"
  },
  "scripts": {
    "build": "node ../config/build.mjs api",
    "typecheck": "node ../config/typecheck.mjs api",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:vectors": "vitest run --config ../config/vitest.vectors.config.js",
    "test:property": "vitest run --config ../config/vitest.property.config.js",
    "test:cross": "vitest run --config ../config/vitest.api-cross.config.js",
    "test:browser": "node ../config/browser-check.mjs api",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
