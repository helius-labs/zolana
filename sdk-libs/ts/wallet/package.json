{
  "name": "@zolana/wallet",
  "version": "0.1.0",
  "description": "Zolana wallet authorities, actions, registration, and synchronization.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/zolana.git",
    "directory": "sdk-libs/ts/wallet"
  },
  "homepage": "https://github.com/helius-labs/zolana/tree/main/sdk-libs/ts/wallet",
  "bugs": {
    "url": "https://github.com/helius-labs/zolana/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "browserslist": [
    "chrome >= 94",
    "edge >= 94",
    "firefox >= 93",
    "safari >= 16.4",
    "ios >= 16.4"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    },
    "./authority": {
      "browser": {
        "types": "./dist/es/authority/index.d.ts",
        "default": "./dist/es/authority/index.js"
      },
      "import": {
        "types": "./dist/es/authority/index.d.ts",
        "default": "./dist/es/authority/index.js"
      },
      "require": {
        "types": "./dist/cjs/authority/index.d.ts",
        "default": "./dist/cjs/authority/index.js"
      },
      "default": "./dist/es/authority/index.js"
    },
    "./registry": {
      "browser": {
        "types": "./dist/es/registry/index.d.ts",
        "default": "./dist/es/registry/index.js"
      },
      "import": {
        "types": "./dist/es/registry/index.d.ts",
        "default": "./dist/es/registry/index.js"
      },
      "require": {
        "types": "./dist/cjs/registry/index.d.ts",
        "default": "./dist/cjs/registry/index.js"
      },
      "default": "./dist/es/registry/index.js"
    },
    "./actions": {
      "browser": {
        "types": "./dist/es/actions/index.d.ts",
        "default": "./dist/es/actions/index.js"
      },
      "import": {
        "types": "./dist/es/actions/index.d.ts",
        "default": "./dist/es/actions/index.js"
      },
      "require": {
        "types": "./dist/cjs/actions/index.d.ts",
        "default": "./dist/cjs/actions/index.js"
      },
      "default": "./dist/es/actions/index.js"
    },
    "./sync": {
      "browser": {
        "types": "./dist/es/sync/index.d.ts",
        "default": "./dist/es/sync/index.js"
      },
      "import": {
        "types": "./dist/es/sync/index.d.ts",
        "default": "./dist/es/sync/index.js"
      },
      "require": {
        "types": "./dist/cjs/sync/index.d.ts",
        "default": "./dist/cjs/sync/index.js"
      },
      "default": "./dist/es/sync/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "dependencies": {
    "@zolana/client": "0.1.0",
    "@zolana/hasher": "0.1.0",
    "@zolana/interface": "0.1.0",
    "@zolana/keypair": "0.1.0",
    "@zolana/transaction": "0.1.0"
  },
  "scripts": {
    "build": "node ../config/build.mjs wallet",
    "typecheck": "node ../config/typecheck.mjs wallet",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:vectors": "vitest run --config ../config/vitest.vectors.config.js",
    "test:cross": "vitest run --config ../config/vitest.package.config.js test/wallet.test.ts",
    "test:browser": "node ../config/browser-check.mjs wallet",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
