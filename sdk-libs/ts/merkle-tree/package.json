{
  "name": "@zolana/merkle-tree",
  "version": "0.1.0",
  "description": "Deterministic Zolana Merkle and indexed Merkle trees.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@zolana/interface": "0.1.0"
  },
  "scripts": {
    "build": "node ../config/build.mjs merkle-tree",
    "typecheck": "node ../config/typecheck.mjs merkle-tree",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:vectors": "vitest run --config ../config/vitest.vectors.config.js",
    "test:property": "vitest run --config ../config/vitest.property.config.js",
    "test:browser": "node ../config/browser-check.mjs merkle-tree",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
