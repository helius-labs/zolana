{
  "name": "@zolana/hasher",
  "version": "0.1.0",
  "description": "Zolana's Poseidon, compiled from Rust to WebAssembly.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0 <23"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      },
      "default": "./dist/es/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "dependencies": {},
  "scripts": {
    "build": "node ../config/build.mjs hasher",
    "typecheck": "node ../config/typecheck.mjs hasher",
    "lint": "eslint \"src/index.ts\" \"test/**/*.ts\"",
    "test:unit": "vitest run --config ../config/vitest.package.config.js --passWithNoTests",
    "test:vectors": "vitest run --config ../config/vitest.vectors.config.js",
    "test:browser": "node ../config/browser-check.mjs hasher",
    "embed": "node scripts/embed.mjs",
    "api:check": "node ../config/workspace-check.mjs api"
  }
}
