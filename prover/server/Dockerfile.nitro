# Build context is the repository root.
# BACKEND=aeglos-cpu needs the aeglos_source build context.
ARG BACKEND=gnark

FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS source

WORKDIR /app
COPY prover/server/go.mod prover/server/go.sum ./
RUN go mod download && go mod verify
COPY prover/server/ ./

FROM source AS gnark
ARG GOAMD64
ARG PROVER_PGO
RUN GOAMD64="$GOAMD64" PROVER_PGO="$PROVER_PGO" sh ./build-release.sh /usr/local/bin/light-prover

FROM source AS aeglos-cpu
RUN apk add --no-cache bash=5.3.9-r1 g++=15.2.0-r5 make=4.4.1-r4 musl-dev=1.2.6-r2
ARG GOAMD64
ARG AEGLOS_UNPINNED
RUN --mount=type=bind,from=aeglos_source,target=/tmp/aeglos-source \
    GOAMD64="$GOAMD64" AEGLOS_UNPINNED="$AEGLOS_UNPINNED" PROVER_EXTLDFLAGS=-static \
    ./build-aeglos.sh /tmp/aeglos-source cpu /usr/local/bin/light-prover

FROM ${BACKEND} AS builder

ARG BACKEND
ARG INDEXER_URL=
ARG CONCURRENCY=2
ARG KEY_SOURCE=boot
ARG KMS_KEY_ARN=
ARG REQUEST_TIMING=
RUN mkdir /out \
    && case $BACKEND in gnark) ;; aeglos-cpu) echo "$BACKEND" > /out/backend ;; *) echo "BACKEND must be gnark or aeglos-cpu" >&2; exit 1 ;; esac \
    && case $REQUEST_TIMING in "") ;; on) echo on > /out/request-timing ;; *) echo "REQUEST_TIMING must be empty or on" >&2; exit 1 ;; esac \
    && case $CONCURRENCY in [1-9] | [1-9][0-9]) ;; *) echo "CONCURRENCY must be 1 to 99" >&2; exit 1 ;; esac \
    && echo "$CONCURRENCY" > /out/concurrency \
    && case $KEY_SOURCE in \
        kms) [ -n "$KMS_KEY_ARN" ] || { echo "KEY_SOURCE=kms needs KMS_KEY_ARN" >&2; exit 1; } ;; \
        boot) [ -z "$KMS_KEY_ARN" ] || { echo "KEY_SOURCE=boot takes no KMS_KEY_ARN" >&2; exit 1; } ;; \
        *) echo "KEY_SOURCE must be kms or boot" >&2; exit 1 ;; \
    esac \
    && echo "$KEY_SOURCE" > /out/key-source \
    && sh nitro/routes.sh prover/common/key_downloader.go "$INDEXER_URL" "$KMS_KEY_ARN" > /out/routes \
    && printf '%s\n' "$KMS_KEY_ARN" > /out/kms-key \
    && printf '%s\n' "$INDEXER_URL" > /out/indexer-url

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache \
        ca-certificates=20260909-r0 \
        libncursesw=6.5_p20250503-r0 \
        ncurses-terminfo-base=6.5_p20250503-r0 \
        readline=8.2.13-r1 \
        socat=1.8.1.3-r0 \
        su-exec=0.2-r3 \
    && printf 'hosts: files\n' > /etc/nsswitch.conf \
    && mkdir /proving-keys
COPY --from=builder /usr/local/bin/light-prover /usr/local/bin/light-prover
COPY --from=builder /out/ /etc/zolana-nitro/
COPY prover/server/nitro/entrypoint.sh /usr/local/bin/zolana-enclave
COPY LICENSE THIRD_PARTY_NOTICES /usr/share/licenses/zolana/

CMD ["/usr/local/bin/zolana-enclave"]
