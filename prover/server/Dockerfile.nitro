# Build context is the repository root.
# BACKEND=aeglos-cpu needs the aeglos_source build context, PROVER_EXTENSION_REF
# the prover-extension one as Dockerfile.light describes.
ARG BACKEND=gnark
ARG PROVER_EXTENSION_REF=

FROM golang:1.27.3-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS source

WORKDIR /src/zolana/prover/server
COPY prover/server/go.mod prover/server/go.sum ./
RUN go mod download && go mod verify
COPY prover/server/ ./
ENV PROVER_MAIN=/src/zolana/prover/server

FROM source AS source-extension
WORKDIR /src/prover
COPY --from=prover-extension prover/go.mod prover/go.sum ./
RUN go mod download && go mod verify
COPY --from=prover-extension prover/ ./
ENV PROVER_MAIN=/src/prover/cmd/prover

FROM source${PROVER_EXTENSION_REF:+-extension} AS main

FROM main AS gnark
ARG GOAMD64
ARG PROVER_PGO
RUN GOAMD64="$GOAMD64" PROVER_PGO="$PROVER_PGO" sh /src/zolana/prover/server/build-release.sh /usr/local/bin/light-prover "$PROVER_MAIN"

FROM main AS aeglos-cpu
RUN apk add --no-cache bash=5.3.9-r1 g++=15.2.0-r5 make=4.4.1-r4 musl-dev=1.2.6-r3
ARG GOAMD64
ARG AEGLOS_UNPINNED
RUN --mount=type=bind,from=aeglos_source,target=/tmp/aeglos-source \
    GOAMD64="$GOAMD64" AEGLOS_UNPINNED="$AEGLOS_UNPINNED" PROVER_EXTLDFLAGS=-static \
    /src/zolana/prover/server/build-aeglos.sh /tmp/aeglos-source cpu /usr/local/bin/light-prover "$PROVER_MAIN"

FROM ${BACKEND} AS builder
WORKDIR /src/zolana/prover/server

ARG BACKEND
ARG INDEXER_URL=
ARG CONCURRENCY=2
ARG KEY_SOURCE=boot
ARG KMS_KEY_ARN=
ARG REQUEST_TIMING=
RUN mkdir /out \
    && case $BACKEND in gnark) ;; aeglos-cpu) echo "$BACKEND" > /out/backend ;; *) echo "BACKEND must be gnark or aeglos-cpu" >&2; exit 1 ;; esac \
    && case $REQUEST_TIMING in "") ;; on) echo on > /out/request-timing ;; *) echo "REQUEST_TIMING must be empty or on" >&2; exit 1 ;; esac \
    && case $CONCURRENCY in [1-9] | [1-9][0-9]) ;; *) echo "CONCURRENCY must be 1 to 99" >&2; exit 1 ;; esac \
    && echo "$CONCURRENCY" > /out/concurrency \
    && case $KEY_SOURCE in \
        kms) [ -n "$KMS_KEY_ARN" ] || { echo "KEY_SOURCE=kms needs KMS_KEY_ARN" >&2; exit 1; } ;; \
        boot) [ -z "$KMS_KEY_ARN" ] || { echo "KEY_SOURCE=boot takes no KMS_KEY_ARN" >&2; exit 1; } ;; \
        *) echo "KEY_SOURCE must be kms or boot" >&2; exit 1 ;; \
    esac \
    && echo "$KEY_SOURCE" > /out/key-source \
    && sh nitro/routes.sh prover/common/key_downloader.go "$INDEXER_URL" "$KMS_KEY_ARN" > /out/routes \
    && printf '%s\n' "$KMS_KEY_ARN" > /out/kms-key \
    && printf '%s\n' "$INDEXER_URL" > /out/indexer-url

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS release-keys

RUN mkdir /release-keys && touch -d @0 /release-keys

FROM builder AS release-key-list

RUN light-prover release-keys > /tmp/release-keys && [ -s /tmp/release-keys ]

FROM release-keys AS release-keys-extension

RUN apk add --no-cache curl=8.14.1-r4
# A separate list stage keeps the download cached while the key pins hold.
COPY --from=release-key-list /tmp/release-keys /tmp/release-keys
RUN set -eu; \
    while read -r name sha256 url; do \
        curl -fsSL --retry 3 --connect-timeout 10 -o "/release-keys/$name" "$url"; \
        echo "$sha256  /release-keys/$name" | sha256sum -c -; \
    done < /tmp/release-keys; \
    touch -d @0 /release-keys /release-keys/*

FROM release-keys${PROVER_EXTENSION_REF:+-extension} AS baked-keys

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache \
        ca-certificates=20261020-r0 \
        libncursesw=6.5_p20250503-r0 \
        ncurses-terminfo-base=6.5_p20250503-r0 \
        readline=8.2.13-r1 \
        socat=1.8.1.3-r0 \
        su-exec=0.2-r3 \
    && printf 'hosts: files\n' > /etc/nsswitch.conf \
    && mkdir /proving-keys
COPY --from=builder /usr/local/bin/light-prover /usr/local/bin/light-prover
COPY --from=builder /out/ /etc/zolana-nitro/
COPY --from=baked-keys /release-keys/ /usr/share/zolana/release-keys/
COPY prover/server/nitro/entrypoint.sh /usr/local/bin/zolana-enclave
COPY LICENSE THIRD_PARTY_NOTICES /usr/share/licenses/zolana/

CMD ["/usr/local/bin/zolana-enclave"]
