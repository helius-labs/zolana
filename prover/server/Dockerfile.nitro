# Build context is the repository root.
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder

WORKDIR /app
COPY prover/server/go.mod prover/server/go.sum ./
RUN go mod download && go mod verify
COPY prover/server/ ./

ARG GOAMD64
ARG PROVER_PGO
RUN GOAMD64="$GOAMD64" PROVER_PGO="$PROVER_PGO" sh ./build-release.sh /usr/local/bin/light-prover

ARG INDEXER_URL=
ARG CONCURRENCY=2
ARG KEY_SOURCE=boot
ARG KMS_KEY_ARN=
RUN mkdir /out \
    && case $CONCURRENCY in [1-9] | [1-9][0-9]) ;; *) echo "CONCURRENCY must be 1 to 99" >&2; exit 1 ;; esac \
    && echo "$CONCURRENCY" > /out/concurrency \
    && case $KEY_SOURCE in \
        kms) [ -n "$KMS_KEY_ARN" ] || { echo "KEY_SOURCE=kms needs KMS_KEY_ARN" >&2; exit 1; } ;; \
        boot) [ -z "$KMS_KEY_ARN" ] || { echo "KEY_SOURCE=boot takes no KMS_KEY_ARN" >&2; exit 1; } ;; \
        *) echo "KEY_SOURCE must be kms or boot" >&2; exit 1 ;; \
    esac \
    && echo "$KEY_SOURCE" > /out/key-source \
    && sh nitro/routes.sh prover/common/key_downloader.go "$INDEXER_URL" "$KMS_KEY_ARN" > /out/routes \
    && printf '%s\n' "$KMS_KEY_ARN" > /out/kms-key \
    && printf '%s\n' "$INDEXER_URL" > /out/indexer-url

# The proving keys proving-keys.lock marks as release assets, which the prover
# never downloads, checked against their pinned sha256.
FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8 AS release-keys

RUN apk add --no-cache curl=8.14.1-r3 jq=1.8.2-r0
ARG RELEASE_KEYS_URL=https://github.com/helius-labs/zolana/releases/download/custom-ring-keys-v16
COPY prover/server/prover/provingkeys/proving-keys.lock /tmp/proving-keys.lock
RUN set -eu; \
    mkdir /release-keys; \
    jq -r '.keys | to_entries[] | select(.value.source == "release") | "\(.key) \(.value.sha256)"' \
        /tmp/proving-keys.lock > /tmp/release-keys; \
    [ -s /tmp/release-keys ]; \
    while read -r name sha256; do \
        curl -fsSL --retry 3 --connect-timeout 10 -o "/release-keys/$name" "$RELEASE_KEYS_URL/$name"; \
        echo "$sha256  /release-keys/$name" | sha256sum -c -; \
    done < /tmp/release-keys; \
    touch -d @0 /release-keys /release-keys/*

FROM alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8

RUN apk add --no-cache \
        ca-certificates=20260909-r0 \
        libncursesw=6.5_p20250503-r0 \
        ncurses-terminfo-base=6.5_p20250503-r0 \
        readline=8.2.13-r1 \
        socat=1.8.1.3-r0 \
        su-exec=0.2-r3 \
    && printf 'hosts: files\n' > /etc/nsswitch.conf \
    && mkdir /proving-keys
COPY --from=builder /usr/local/bin/light-prover /usr/local/bin/light-prover
COPY --from=builder /out/ /etc/zolana-nitro/
COPY --from=release-keys /release-keys/ /usr/share/zolana/release-keys/
COPY prover/server/nitro/entrypoint.sh /usr/local/bin/zolana-enclave
COPY LICENSE THIRD_PARTY_NOTICES /usr/share/licenses/zolana/

CMD ["/usr/local/bin/zolana-enclave"]
