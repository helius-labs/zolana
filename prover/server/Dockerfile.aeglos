FROM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS go
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:a99a1860ba8e2916e5c3e73b72ec4c4301653a84586e05bfc9a2aa2d58027e97 AS builder

COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates make g++ git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
ARG CUDA_ARCH
RUN --mount=type=bind,from=aeglos_source,target=/tmp/aeglos-source \
    ./build-aeglos.sh /tmp/aeglos-source "$CUDA_ARCH" /usr/local/bin/light-prover

FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04@sha256:4a801ef9232d2b05e69df4eb8aa054dbbe2824e5499e1e6e857320bb01ac41a9
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/light-prover /usr/local/bin/light-prover
COPY --from=repository LICENSE THIRD_PARTY_NOTICES /usr/share/licenses/zolana/
USER 65532:65532
ENTRYPOINT ["light-prover"]
CMD ["start", "--require-optimized-build", "--server-only", "--auto-download", "--preload-keys", "none", "--keys-dir", "/proving-keys"]
