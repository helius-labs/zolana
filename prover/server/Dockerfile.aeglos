FROM golang:1.27.1-bookworm@sha256:69a7b9788769bec032d238959b61854e9ae87f57be9029ec04e9885fabf99195 AS go
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:a99a1860ba8e2916e5c3e73b72ec4c4301653a84586e05bfc9a2aa2d58027e97 AS builder

COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates make g++ git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
COPY --from=aeglos_source / /tmp/aeglos-source/
RUN cd /tmp/aeglos-source && sha256sum -c /app/prover/backend/aeglos-source.lock && \
    mkdir -p /opt/aeglos && \
    tar -xf aeglos-63450b2fcde9f2949b794e276889798b06dcbfed.tar -C /opt/aeglos
ENV GOWORK=/build/go.work
RUN mkdir /build && cd /build && go work init /app /opt/aeglos && \
    go mod download && go mod verify
ARG CUDA_ARCH=sm_89
RUN make -C /opt/aeglos BUILD_DIR=/tmp/aeglos-build ARCH="$CUDA_ARCH" install
ENV CGO_ENABLED=1
ENV CGO_LDFLAGS="-L/usr/local/lib -L/usr/local/cuda/lib64"
ARG GOAMD64=v3
RUN test -z "$(go env GOFLAGS)" && GOAMD64="$GOAMD64" go build -tags aeglos -trimpath -pgo=auto -ldflags="-s -w -buildid=" -o /usr/local/bin/light-prover .

FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04@sha256:4a801ef9232d2b05e69df4eb8aa054dbbe2824e5499e1e6e857320bb01ac41a9
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/local/bin/light-prover /usr/local/bin/light-prover
USER 65532:65532
ENV PROVER_BACKEND=aeglos
ENTRYPOINT ["light-prover"]
CMD ["start", "--require-optimized-build", "--keys-dir", "/proving-keys/"]
