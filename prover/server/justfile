# Light Prover Server

export TEST_REDIS_URL := env_var_or_default("TEST_REDIS_URL", "redis://localhost:6379/15")

default:
    @just --list

# === Build ===
build:
    go build ./...

build-binary:
    sh build-release.sh light-prover

# === Tests (no Redis required) ===
test-unit:
    go test ./prover/... -timeout 60m

test-worker-selection:
    go test -v -run TestWorkerSelection -timeout 5m

test-batch-operations:
    go test -v -run TestBatchOperations -timeout 5m

# The vendored extractor is a nested module, so ./... does not cover it.
test-extractor:
    go test -C tools/gnark-lean-extractor ./...

test-no-redis: test-unit test-worker-selection test-batch-operations test-extractor

# === Tests (Redis required) ===
test-redis:
    go test -v -run TestRedis -timeout 10m

test-cleanup:
    go test -v -run TestCleanup -timeout 5m

test-job-processing-flow:
    go test -v -run TestJobProcessingFlow -timeout 5m

test-failed-job-status:
    go test -v -run TestFailedJobStatus -timeout 5m

test-with-redis: test-redis test-cleanup test-job-processing-flow test-failed-job-status

# === Integration Tests ===
test-lightweight:
    go test -run TestLightweight -timeout 15m

test-lightweight-lazy:
    go test -run TestLightweightLazy -timeout 15m

# Excluded from test-integration and test due to 120m timeout; run manually for exhaustive testing
test-full:
    go test -run TestFull -timeout 120m

test-integration: test-lightweight test-lightweight-lazy

# === All Tests ===
# Note: test-full excluded to avoid slow CI runs
test: test-no-redis test-with-redis test-integration

# === Benchmarks ===

# SPP proving benchmark (solana + p256 rails, every shape); appends to BENCHMARKS.md.
bench-spp benchtime="5x":
    scripts/bench_spp.sh {{benchtime}}

# === Formal Verification ===
extract-circuit: build-binary
    ./light-prover extract-circuit --output formal-verification/FormalVerification/Circuit.lean --state-tree-height 32 --nullifier-tree-height 40 --batch-size 8

# `cache get` is best-effort: it downloads prebuilt mathlib oleans (hard
# requirement for CI speed) but its binary can crash on some macOS versions;
# lake build falls back to compiling mathlib from source.
lean-build:
    cd formal-verification && (lake exe cache get || true) && lake build

# The VerifiableEncryption library peaks at about 8.5 GB per Lean process
# (AxiomsCurve), so it builds with at most two concurrent Lean processes.
lean-build-ve:
    cd formal-verification && (lake exe cache get || true) && LEAN_NUM_THREADS=2 lake build VerifiableEncryption

extract-ve-circuit: build-binary
    ./light-prover extract-ve-circuit --output-dir formal-verification

# Regenerates every generated file of the VerifiableEncryption library in
# dependency order: the circuit extraction, then the Go tables, certificates and
# instance modules, then the Python proof generators that read the extraction,
# and last the library root, which imports every module.
regen-ve-formal: build-binary
    ./light-prover extract-ve-circuit --output-dir formal-verification
    ./light-prover extract-ve-tables --output-dir formal-verification
    cd formal-verification && python3 scripts/gen_field_bytes.py
    cd formal-verification && python3 scripts/gen_envelope_bodies.py
    cd formal-verification && python3 scripts/gen_aes_key_expansion.py VerifiableEncryption/Aes/KeyExpansion.lean
    cd formal-verification && python3 scripts/gen_aes_ctr_block.py VerifiableEncryption/Aes/CtrBlock.lean
    cd formal-verification && python3 scripts/gen_aes_envelope.py VerifiableEncryption/Aes/EnvelopeAes.lean
    cd formal-verification && python3 scripts/gen_comb_limbs.py
    cd formal-verification && python3 scripts/gen_ve_root.py

verify: extract-circuit regen-ve-formal lean-build lean-build-ve
