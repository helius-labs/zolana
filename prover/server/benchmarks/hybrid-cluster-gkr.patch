+func TestHybridScreen(t *testing.T) {
+ for _, size := range []int{1,16,512} {
+  for _, gkr := range []bool{false,true} {
+   c := newCompactPayment(512, false)
+   c.setClusters(size)
+   c.Balance.Outputs = make([]direct.Output, 2)
+   c.ExternalAdmission, c.Freshness.Witnesses, c.GKR = true, nil, gkr
+   cs, err := frontend.Compile(ecc.BN254.ScalarField(), r1cs.NewBuilder, c, frontend.WithCompressThreshold(300))
+   if err != nil { t.Fatal(err) }
+   constraints := cs.GetNbConstraints()
+   t.Logf("HYBRID inputs=512 outputs=2 cluster_size=%d external_admission=true gkr=%t constraints=%d fft_domain=%d", size, gkr, constraints, uint64(1)<<bits.Len64(uint64(constraints-1)))
+   runtime.GC()
+  }
+ }
