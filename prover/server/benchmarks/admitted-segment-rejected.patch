+package directspend
+
+import (
+	"fmt"
+	"os"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/frontend/cs/r1cs"
+
+	"zolana/prover/circuits/gadget"
+)
+
+type SegmentedAdmittedPayment struct {
+	AdmittedPaymentCircuit
+	Rounds int `gnark:"-"`
+}
+
+func (c *SegmentedAdmittedPayment) Define(api frontend.API) error {
+	compressor, err := gadget.NewSegmentedGKRCompressor(api, c.Rounds)
+	if err != nil {
+		return err
+	}
+	return c.AdmittedPaymentCircuit.constrain(api, compressor, c.Certificate.StateRoot, 32)
+}
+
+func TestAdmittedSegmentConstraints(t *testing.T) {
+	if os.Getenv("ADMITTED_SEGMENT_COUNTS") == "" {
+		t.Skip("set ADMITTED_SEGMENT_COUNTS=1")
+	}
+	for _, rounds := range []int{16, 24, 32} {
+		t.Run(fmt.Sprint(rounds), func(t *testing.T) {
+			c := &SegmentedAdmittedPayment{AdmittedPaymentCircuit: *NewAdmittedPayment(512, 2), Rounds: rounds}
+			cs, err := frontend.Compile(ecc.BN254.ScalarField(), r1cs.NewBuilder, c, frontend.WithCompressThreshold(300))
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Logf("ADMITTED_SEGMENT inputs=512 rounds=%d constraints=%d fft_domain=%d", rounds, cs.GetNbConstraints(), ecc.NextPowerOfTwo(uint64(cs.GetNbConstraints())))
+		})
+	}
+}
