+package gadget
+
+import (
+	"fmt"
+	"math/big"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/constraint/solver"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/std/gkrapi"
+	"github.com/consensys/gnark/std/gkrapi/gkr"
+	"github.com/iden3/go-iden3-crypto/poseidon"
+)
+
+type SegmentedGKRCompressor struct {
+	api      frontend.API
+	rounds   int
+	requests [][3]frontend.Variable
+}
+
+func NewSegmentedGKRCompressor(api frontend.API, rounds int) (*SegmentedGKRCompressor, error) {
+	if api.Compiler().Field().Cmp(ecc.BN254.ScalarField()) != 0 || rounds < 1 || rounds > 65 {
+		return nil, fmt.Errorf("invalid segmented Poseidon configuration")
+	}
+	c := &SegmentedGKRCompressor{api: api, rounds: rounds}
+	api.Compiler().Defer(c.constrain)
+	return c, nil
+}
+
+func (c *SegmentedGKRCompressor) Compress(left, right frontend.Variable) frontend.Variable {
+	result, err := c.api.Compiler().NewHint(segmentedPoseidonHint, 1, left, right)
+	if err != nil {
+		panic(err)
+	}
+	c.requests = append(c.requests, [3]frontend.Variable{left, right, result[0]})
+	return result[0]
+}
+
+func init() {
+	solver.RegisterHint(segmentedPoseidonHint)
+}
+
+func segmentedPoseidonHint(_ *big.Int, in, out []*big.Int) error {
+	result, err := poseidon.Hash(in)
+	if err != nil {
+		return err
+	}
+	out[0].Set(result)
+	return nil
+}
+
+type poseidonRound struct {
+	power  [3]int
+	ark    [3]*big.Int
+	matrix [3][3]*big.Int
+}
+
+func legacyPoseidonRounds() []poseidonRound {
+	constants := elemsToBigInt(iden3C.c[1])
+	sparse := elemsToBigInt(iden3C.s[1])
+	matrix := elems2DToBigInt(iden3C.m[1])
+	transition := elems2DToBigInt(iden3C.p[1])
+	rounds := make([]poseidonRound, 0, 65)
+	full := func(ark []*big.Int, m [][]*big.Int) {
+		round := poseidonRound{power: [3]int{1, 1, 1}}
+		for i := range 3 {
+			round.ark[i] = new(big.Int)
+			if ark != nil {
+				round.ark[i] = ark[i]
+			}
+			copy(round.matrix[i][:], m[i])
+		}
+		rounds = append(rounds, round)
+	}
+	for i := range 3 {
+		full(constants[(i+1)*3:(i+2)*3], matrix)
+	}
+	full(constants[12:15], transition)
+	for i := range 57 {
+		s := sparse[i*5 : (i+1)*5]
+		rounds = append(rounds, poseidonRound{
+			power: [3]int{1, 0, 0},
+			ark:   [3]*big.Int{constants[15+i], new(big.Int), new(big.Int)},
+			matrix: [3][3]*big.Int{
+				{s[0], s[3], s[4]},
+				{s[1], big.NewInt(1), new(big.Int)},
+				{s[2], new(big.Int), big.NewInt(1)},
+			},
+		})
+	}
+	for i := range 3 {
+		full(constants[72+i*3:75+i*3], matrix)
+	}
+	full(nil, matrix)
+	return rounds
+}
+
+func (c *SegmentedGKRCompressor) constrain(api frontend.API) error {
+	if len(c.requests) == 0 {
+		return nil
+	}
+	g, err := gkrapi.New(api)
+	if err != nil {
+		return err
+	}
+	inputs := [3]gkr.Variable{g.NewInput(), g.NewInput(), g.NewInput()}
+	state := inputs
+	parameters := make([][15]gkr.Variable, c.rounds)
+	for r := range parameters {
+		for i := range parameters[r] {
+			parameters[r][i] = g.NewInput()
+		}
+		previous := state
+		for output := range 3 {
+			state[output] = g.Gate(func(api gkr.GateAPI, in ...frontend.Variable) frontend.Variable {
+				result := frontend.Variable(0)
+				for lane := range 3 {
+					value := api.Add(in[lane], api.Mul(in[3+lane], api.Sub(powerFive(api, in[lane]), in[lane])))
+					value = api.Add(value, in[6+lane])
+					result = api.Add(result, api.Mul(in[9+lane*3+output], value))
+				}
+				return result
+			}, append(previous[:], parameters[r][:]...)...)
+		}
+	}
+	circuit, err := g.Compile("POSEIDON2")
+	if err != nil {
+		return err
+	}
+	rounds := legacyPoseidonRounds()
+	constants := elemsToBigInt(iden3C.c[1])
+	states := make([][3]frontend.Variable, len(c.requests))
+	for i, request := range c.requests {
+		states[i] = [3]frontend.Variable{constants[0], api.Add(request[0], constants[1]), api.Add(request[1], constants[2])}
+	}
+	for first := 0; first < len(rounds); first += c.rounds {
+		fixed := make(map[gkr.Variable]frontend.Variable, len(parameters)*15+3)
+		for r := range c.rounds {
+			round := poseidonRound{}
+			if first+r < len(rounds) {
+				round = rounds[first+r]
+			} else {
+				for i := range 3 {
+					round.ark[i] = new(big.Int)
+					for j := range 3 {
+						round.matrix[i][j] = new(big.Int)
+					}
+					round.matrix[i][i] = big.NewInt(1)
+				}
+			}
+			for i := range 3 {
+				fixed[parameters[r][i]], fixed[parameters[r][3+i]] = round.power[i], round.ark[i]
+				for j := range 3 {
+					fixed[parameters[r][6+i*3+j]] = round.matrix[i][j]
+				}
+			}
+		}
+		for i := range states {
+			for lane := range 3 {
+				fixed[inputs[lane]] = states[i][lane]
+			}
+			outputs, err := circuit.AddInstance(fixed)
+			if err != nil {
+				return err
+			}
+			for lane := range 3 {
+				states[i][lane] = outputs[state[lane]]
+			}
+		}
+	}
+	for i, request := range c.requests {
+		api.AssertIsEqual(states[i][0], request[2])
+	}
+	return nil
+}
