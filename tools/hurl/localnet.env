# Variables for a localnet stack at ZOLANA_PORT_OFFSET=0.
#
#   hurl --test --variables-file tools/hurl/localnet.env tools/hurl/indexer/*.hurl
#
# With an offset N the ports shift: indexer 8784+N, prover 3001+N, prover
# metrics 9998+N (cli/src/prover.rs keeps the metrics port at the same offset as
# the prover port). `just hurl-indexer` / `just hurl-prover` derive all three
# from the justfile's port variables, so prefer those over editing this file.
indexer_url=http://127.0.0.1:8784
prover_url=http://127.0.0.1:3001
prover_metrics_url=http://127.0.0.1:9998

# Query keys that deliberately match nothing: 32 zero bytes. Every query answers
# an empty page, which is what the response-shape assertions want. Point them at
# real values to look at real data.
tag=11111111111111111111111111111111
nullifier=11111111111111111111111111111111
signature=1111111111111111111111111111111111111111111111111111111111111111
# Ring filter for the by-tags queries; the zero address matches no ring.
ring_program_id=11111111111111111111111111111111
# A well-formed address the indexer has no tree for, for the rejection paths.
unknown_tree=11111111111111111111111111111111

# 32 bytes of 0x01: inside the BN254 scalar field and not a nullifier any wallet
# will produce, so getNonInclusionProofs answers it with a real low-element
# witness instead of rejecting it as already spent.
unused_nullifier=4vJ9JU1bJJE96FWSJKvHsmmFADCg4gpZQff4P3bkLKi

# 32 bytes of 0xff: a well-formed 32-byte base58 value that is NOT a BN254 field
# element, for the validation path.
out_of_field_leaf=JEKNVnkbo3jma5nREBBJCDoXFVeKkD56V3xKrvRmWxFG

page_limit=10

# Required by indexer/proofs.hurl, which reads real tree state. Uncomment and
# fill, or pass --variable tree=... --variable leaf=...
# tree=
# leaf=

# Required by the prover/prove*.hurl and prover/queue.hurl entries that send a
# real witness: a captured /prove request body, relative to `--file-root
# tools/hurl`. See README.md for the capture recipe.
# witness=fixtures/transfer-2x2.json
