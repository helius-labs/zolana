+++ b/crates/frontend/src/builder_tests.rs
@@ -0,0 +1,151 @@
+use super::*;
+use xark_ir::{FieldSpec, primitive::PrimitiveProgram, solver::solve_and_check};
+
+fn input(builder: &mut Builder, name: &str) -> LinearCombination {
+    let id = builder.alloc_var(name.into(), Visibility::Private);
+    builder.input_ids.push(id);
+    LinearCombination::var(id)
+}
+
+fn accepts(program: &PrimitiveProgram, values: &[(&str, u64)]) -> bool {
+    let inputs = values
+        .iter()
+        .map(|(name, value)| {
+            let id = program
+                .vars
+                .iter()
+                .find(|var| var.name == *name)
+                .unwrap()
+                .id;
+            (id, value.to_string())
+        })
+        .collect();
+    solve_and_check(program, &inputs).is_ok()
+}
+
+#[test]
+fn equality_elides_only_identically_zero_differences() {
+    let mut builder = Builder::new(false);
+    let left = input(&mut builder, "left");
+    let right = input(&mut builder, "right");
+    builder.emit_require_eq(LinearCombination::zero(), LinearCombination::zero());
+    builder.emit_require_eq(left.clone() + right.clone(), right.clone() + left.clone());
+    assert!(builder.constraints.is_empty());
+    builder.emit_require_eq(left, right);
+    assert_eq!(builder.constraints.len(), 1);
+    let program = crate::output::finish(builder, FieldSpec::named("bn254"), 2).primitive;
+    assert!(accepts(&program, &[("left", 7), ("right", 7)]));
+    assert!(!accepts(&program, &[("left", 7), ("right", 8)]));
+
+    let mut builder = Builder::new(false);
+    builder.emit_require_eq(LinearCombination::zero(), LinearCombination::one());
+    assert_eq!(builder.constraints.len(), 1);
+    let program = crate::output::finish(builder, FieldSpec::named("bn254"), 0).primitive;
+    assert!(!accepts(&program, &[]));
+}
+
+#[test]
+fn comparison_and_subtraction_share_a_constrained_borrow_in_both_orders() {
+    for comparison_first in [false, true] {
+        let mut builder = Builder::new(false);
+        let left = input(&mut builder, "left");
+        let right = input(&mut builder, "right");
+        let expected_borrow = input(&mut builder, "borrow");
+        let expected_remainder = input(&mut builder, "remainder");
+        builder.emit_range_proof_lc(left.clone(), 3);
+        builder.emit_range_proof_lc(right.clone(), 3);
+        let (remainder, borrow) = if comparison_first {
+            let borrow = builder
+                .emit_less_than(3, left.clone(), right.clone())
+                .unwrap();
+            let rows = builder.constraints.len();
+            let remainder = builder.emit_wrapping_sub(3, left, right);
+            assert_eq!(
+                builder.constraints.len(),
+                rows,
+                "subtraction reuses comparison"
+            );
+            (remainder, borrow)
+        } else {
+            let remainder = builder.emit_wrapping_sub(3, left.clone(), right.clone());
+            let rows = builder.constraints.len();
+            let borrow = builder.emit_less_than(3, left, right).unwrap();
+            assert_eq!(
+                builder.constraints.len(),
+                rows,
+                "comparison reuses subtraction"
+            );
+            (remainder, borrow)
+        };
+        builder.emit_require_eq(remainder, expected_remainder);
+        builder.emit_require_eq(borrow, expected_borrow);
+        let program = crate::output::finish(builder, FieldSpec::named("bn254"), 4).primitive;
+        for left in 0u64..8 {
+            for right in 0..8 {
+                let borrow = u64::from(left < right);
+                let remainder = left.wrapping_sub(right) & 7;
+                let inputs = [
+                    ("left", left),
+                    ("right", right),
+                    ("borrow", borrow),
+                    ("remainder", remainder),
+                ];
+                assert!(accepts(&program, &inputs));
+                let mut forged = inputs;
+                forged[2].1 ^= 1;
+                assert!(!accepts(&program, &forged), "forged borrow: {forged:?}");
+                forged = inputs;
+                forged[3].1 ^= 1;
+                assert!(!accepts(&program, &forged), "forged remainder: {forged:?}");
+            }
+        }
+    }
+}
+
+#[test]
+fn guarded_or_witness_only_comparisons_do_not_populate_the_unsigned_cache() {
+    for witness_only in [false, true] {
+        let mut builder = Builder::new(false);
+        let left = input(&mut builder, "left");
+        let right = input(&mut builder, "right");
+        let gate = input(&mut builder, "gate");
+        builder.witness_only = witness_only;
+        builder
+            .emit_less_than_gated(3, left.clone(), right.clone(), Some(gate))
+            .unwrap();
+        builder.witness_only = false;
+        assert!(builder.unsigned_subs.is_empty());
+        let rows = builder.constraints.len();
+        builder.emit_wrapping_sub(3, left, right);
+        assert!(builder.constraints.len() > rows);
+    }
+    let mut builder = Builder::new(false);
+    let left = input(&mut builder, "left");
+    let right = input(&mut builder, "right");
+    builder.witness_only = true;
+    builder
+        .emit_less_than(3, left.clone(), right.clone())
+        .unwrap();
+    assert!(builder.unsigned_subs.is_empty());
+    builder.emit_wrapping_sub(3, left.clone(), right.clone());
+    builder.witness_only = false;
+    assert!(builder.unsigned_subs.is_empty());
+    builder.emit_less_than(3, left, right).unwrap();
+    assert!(!builder.constraints.is_empty());
+}
+
+#[test]
+fn unsigned_cache_does_not_cross_widths_or_operand_order() {
+    let mut builder = Builder::new(false);
+    let left = input(&mut builder, "left");
+    let right = input(&mut builder, "right");
+    builder.emit_wrapping_sub(3, left.clone(), right.clone());
+    let rows = builder.constraints.len();
+    builder
+        .emit_less_than(4, left.clone(), right.clone())
+        .unwrap();
+    assert!(builder.constraints.len() > rows);
+    let rows = builder.constraints.len();
+    builder.emit_less_than(3, right, left).unwrap();
+    assert!(builder.constraints.len() > rows);
+}
