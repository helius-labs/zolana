+//! Native integer regression cases for shared comparison/subtraction proofs.
+use std::collections::BTreeMap;
+use std::path::PathBuf;
+use xark_ir::{primitive::PrimitiveProgram, solver::solve_and_check};
+
+fn compile(name: &str, parameters: &str, body: &str) -> PrimitiveProgram {
+    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+        .join("../..")
+        .canonicalize()
+        .unwrap();
+    let directory = root.join("target/integer-reuse").join(name);
+    std::fs::create_dir_all(directory.join("src")).unwrap();
+    let language = root.join("crates/lang");
+    std::fs::write(directory.join("Cargo.toml"), format!(
+        "[package]\nname = \"integer-{name}\"\nversion = \"0.0.0\"\nedition = \"2024\"\n[workspace]\n[lib]\ncrate-type = [\"cdylib\", \"rlib\"]\n[dependencies]\nxark = {{ path = {language:?} }}\n[lints.rust]\nunexpected_cfgs = {{ level = \"warn\", check-cfg = ['cfg(xark)', 'cfg(xark_client)'] }}\n"
+    )).unwrap();
+    std::fs::write(directory.join("src/lib.rs"), format!(
+        "#![no_std]\nuse xark::prelude::*;\n#[circuit]\npub fn circuit({parameters}) {{ {body} }}\n"
+    )).unwrap();
+    let wasm =
+        xark_frontend::build_crate(&directory, &root.join("target/integer-reuse/wasm")).unwrap();
+    let lowered =
+        xark_frontend::lower_module(&wasm, xark_ir::FieldSpec::named("bn254"), false, false)
+            .unwrap();
+    // The raw primitive expression view is debug-only (`notes = true`). Exercise
+    // the actual compact artifact consumed by the prover instead.
+    xark_ir::function_decode::expand_function_blob(&lowered.output.xbc)
+        .unwrap()
+        .to_primitive()
+}
+
+fn accepts(program: &PrimitiveProgram, values: &[(&str, u128)]) -> bool {
+    let inputs: BTreeMap<_, _> = values
+        .iter()
+        .map(|(name, value)| {
+            let id = program
+                .vars
+                .iter()
+                .find(|var| var.name == *name)
+                .unwrap()
+                .id;
+            (id, value.to_string())
+        })
+        .collect();
+    solve_and_check(program, &inputs).is_ok()
+}
+
+#[test]
+fn native_u128_addition_rejects_overflow_and_forged_results() {
+    let program = compile(
+        "add",
+        "left: Private<u128>, right: Private<u128>, expected: Public<Field>",
+        "let sum = left.checked_add(right).expect(\"overflow\"); require_eq(Field::from(sum), expected);",
+    );
+    for left in [
+        0,
+        1,
+        u64::MAX as u128,
+        1u128 << 64,
+        u128::MAX - 1,
+        u128::MAX,
+    ] {
+        for right in [0, 1, 7, u64::MAX as u128, 1u128 << 64, u128::MAX] {
+            let sum = left.checked_add(right);
+            let claimed = left.wrapping_add(right);
+            let inputs = [("left", left), ("right", right), ("expected", claimed)];
+            assert_eq!(accepts(&program, &inputs), sum.is_some(), "{inputs:?}");
+            if sum.is_some() {
+                let mut forged = inputs;
+                forged[2].1 ^= 1;
+                assert!(!accepts(&program, &forged), "{forged:?}");
+            }
+        }
+    }
+}
+
+#[test]
+fn native_debit_rejects_underflow_and_wide_remainders() {
+    let program = compile(
+        "debit",
+        "balance: Private<u128>, amount: Private<u64>, expected: Public<Field>",
+        "let low = balance as u64; let high = (balance >> 64) as u64; let borrow = low < amount; require_eq(high, u64::from(borrow)); require_eq(Field::from(low.wrapping_sub(amount)), expected);",
+    );
+    for balance in [
+        0,
+        1,
+        u64::MAX as u128,
+        1u128 << 64,
+        2 * u64::MAX as u128,
+        u128::MAX,
+    ] {
+        for amount in [0u64, 1, 7, u64::MAX] {
+            let remainder = balance
+                .checked_sub(amount as u128)
+                .filter(|remaining| *remaining <= u64::MAX as u128);
+            let claimed = (balance as u64).wrapping_sub(amount) as u128;
+            let inputs = [
+                ("balance", balance),
+                ("amount", amount as u128),
+                ("expected", claimed),
+            ];
+            assert_eq!(
+                accepts(&program, &inputs),
+                remainder.is_some(),
+                "{inputs:?}"
+            );
+            if remainder.is_some() {
+                let mut forged = inputs;
+                forged[2].1 ^= 1;
+                assert!(!accepts(&program, &forged), "{forged:?}");
+            }
+        }
+    }
+}
