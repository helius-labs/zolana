+#[cfg(test)]
+mod input_region_tests {
+    use super::*;
+    use crate::templates::Region;
+    use xark_ir::Visibility;
+
+    #[test]
+    fn renumbering_interleaved_inputs_preserves_region_parent_indices() {
+        let mut builder = Builder::new(false);
+        for name in ["first", "advice", "second", "result"] {
+            builder.alloc_var(name.into(), Visibility::Private);
+        }
+        builder.input_ids = vec![0, 2];
+        builder.regions = vec![
+            Region { c0: 0, c1: 0, w0: 0, w1: 0, v0: 0, v1: 4, parent: None, closed: true },
+            Region { c0: 0, c1: 0, w0: 0, w1: 0, v0: 1, v1: 2, parent: Some(0), closed: true },
+            Region { c0: 0, c1: 0, w0: 0, w1: 0, v0: 3, v1: 4, parent: Some(1), closed: true },
+        ];
+
+        renumber_inputs(&mut builder);
+
+        assert_eq!(
+            builder.regions.iter().map(|region| (region.parent, region.closed)).collect::<Vec<_>>(),
+            vec![(None, false), (Some(0), true), (Some(1), true)],
+        );
+        crate::templates::detect(&mut builder);
+    }
+}
