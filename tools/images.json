{
  "source": "https://github.com/helius-labs/zolana",
  "services": {
    "photon": {
      "repository": "zolana-photon",
      "context": ".",
      "file": "services/photon/Dockerfile",
      "title": "Zolana Photon",
      "description": "Zolana shielded-pool indexer",
      "smoke": "tools/check-photon-image.sh \"$image\""
    },
    "prover": {
      "repository": "zolana-prover",
      "context": "prover/server",
      "file": "prover/server/Dockerfile.light",
      "title": "Zolana Prover",
      "description": "Zolana Groth16 proving server",
      "smoke": "docker run --rm \"$image\" --help >/dev/null"
    },
    "forester": {
      "repository": "zolana-forester",
      "context": ".",
      "file": "protocol-ops/forester/Dockerfile",
      "title": "Zolana Forester",
      "description": "Zolana queue and tree maintenance service",
      "smoke": "docker run --rm \"$image\" --version"
    },
    "tee-policy-freshness": {
      "repository": "zolana-tee-policy-freshness",
      "context": ".",
      "file": "prover/tee/policy/Dockerfile",
      "title": "Zolana TEE policy freshness",
      "description": "Keeps the signed TEE prover policy in force (AWS Lambda)",
      "smoke": "docker run --rm --entrypoint /usr/local/bin/tee-policy \"$image\" --help >/dev/null"
    },
    "canary": {
      "repository": "zolana-canary",
      "context": ".",
      "file": "services/canary/Dockerfile",
      "title": "Zolana Canary",
      "description": "Synthetic private transfer canary",
      "smoke": "docker run --rm \"$image\" --version"
    }
  }
}
