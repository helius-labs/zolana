{
  "name": "timelock-escrow-wasm-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs --threads",
    "build:test": "node tools/build.mjs --threads --test-exports",
    "build:single": "node tools/build.mjs",
    "build:inputs": "node tools/build.mjs --inputs-only",
    "check:dts": "node tools/check-dts.mjs",
    "test": "playwright test --grep-invert @bench",
    "bench": "playwright test --grep @bench --reporter=list",
    "serve": "node tools/serve.mjs",
    "profile": "node tools/profile.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "snarkjs": "0.7.6"
  }
}
