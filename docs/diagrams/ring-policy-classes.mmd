classDiagram
    direction TB

    namespace Account {
        class PolicyConfig {
            policy_hash
            entries_tree
            sources
        }
        class SourceSlot {
            list_id
            namespace
        }
    }
    namespace Program {
        class RuleTable {
            rules
            len
        }
        class Rule {
            subject
            mode
            guard
            source
        }
        class RuleSource {
            <<enumeration>>
            List
            InlineAssets
        }
        class ListId {
            <<enumeration>>
            Allow
            Block
            Frozen
            RingViewing
            Recovery
            Reader
            Approval
            Escrow
        }
        class Writer {
            <<enumeration>>
            Authority
            Member
        }
    }
    namespace EntrySet {
        class ListNamespace {
            owner_hash
        }
        class ListEntry {
            list_id
            member
            state
            version
            content_hash
        }
        class EntryState {
            <<enumeration>>
            Active
            Cleared
        }
        class Member {
            field_element
        }
    }
    namespace Witness {
        class Answers {
            slots
        }
        class RuleAnswer {
            enabled
            list_id
            member
            mode
            absent_branch
        }
    }

    PolicyConfig ..> RuleTable : binds hash at create_policy
    PolicyConfig "1" *-- "8" SourceSlot : positional by list
    SourceSlot "0..1" --> ListNamespace : namespace PDA derives the owner
    RuleTable ..> ListNamespace : hash binds the source map
    RuleTable "1" *-- "0..MAX_RULES" Rule : live rules only hashed
    Rule --> RuleSource
    RuleSource "1" --> "0..1" ListId : List variant only
    ListId --> Writer : writer() gates mutation
    ListEntry --> ListId
    ListEntry --> Member
    ListEntry --> EntryState
    ListNamespace "1" --> "0..*" ListEntry : one lineage per pair
    Answers "1" *-- "ANSWER_SLOTS" RuleAnswer : all slots serialized
    Rule ..> RuleAnswer : one answer per list+member+mode
    RuleAnswer ..> ListEntry : proves present or absent

    note for RuleTable "hash covers rules up to len and all eight source slots"
    note for Answers "disabled slots zero filled, circuit gates on enabled"
    note for Member "zero reserved as padding, never a member"
    note for PolicyConfig "set_policy_source re-points a list, the table alone is pinned"
