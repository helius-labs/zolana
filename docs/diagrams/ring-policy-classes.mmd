classDiagram
    direction TB

    namespace Account {
        class PolicyConfig {
            policy_hash
            entries_tree
            sources
            rules
            generation
            generation_slot
        }
        class SourceSlot {
            list_id
            namespace
        }
        class EncodedRuleTable {
            rule_count
            rules
            inline_count
            inline_assets
        }
    }
    namespace Table {
        class RuleTable {
            rules
            len
            inline_assets
            inline_len
        }
        class Rule {
            subject
            source
            guard
        }
        class RuleSource {
            <<enumeration>>
            Lists(present, absent)
            InlineAssets
        }
        class ListId {
            <<enumeration>>
            Allow
            Block
            Frozen
            RingViewing
            Recovery
            Reader
            Approval
            Escrow
        }
        class Writer {
            <<enumeration>>
            Authority
            Member
        }
    }
    namespace EntrySet {
        class ListNamespace {
            owner_hash
        }
        class ListEntry {
            list_id
            member
            state
            version
            content_hash
        }
        class EntryState {
            <<enumeration>>
            Active
            Cleared
        }
        class Member {
            field_element
        }
    }
    namespace Witness {
        class Answers {
            slots
        }
        class RuleAnswer {
            enabled
            list_id
            member
            mode
            absent_branch
        }
    }

    PolicyConfig "1" *-- "1" EncodedRuleTable : rows, stored at create_policy
    PolicyConfig "1" *-- "8" SourceSlot : positional by list
    EncodedRuleTable ..> RuleTable : decode, trusted under the pinned hash
    SourceSlot "0..1" --> ListNamespace : namespace PDA derives the owner
    EncodedRuleTable ..> ListNamespace : hash binds the source map
    RuleTable "1" *-- "0..MAX_RULES" Rule : rows up to len hashed
    Rule --> RuleSource
    RuleSource "1" --> "0..MAX_SOURCES" ListId : Lists variant only
    ListId --> Writer : writer() gates mutation
    ListEntry --> ListId
    ListEntry --> Member
    ListEntry --> EntryState
    ListNamespace "1" --> "0..*" ListEntry : one lineage per pair
    Answers "1" *-- "ANSWER_SLOTS" RuleAnswer : all slots serialized
    Rule ..> RuleAnswer : one answer per list+member+mode
    RuleAnswer ..> ListEntry : proves present or absent

    note for EncodedRuleTable "hash covers rows up to rule_count, the inline assets and all eight source slots"
    note for Answers "disabled slots zero filled, circuit gates on enabled"
    note for Member "zero reserved as padding, never a member"
    note for PolicyConfig "set_policy_rules replaces the rows under the upgrade authority, set_policy_source re-points a list under the config authority, each write repins the hash and counts a generation"
