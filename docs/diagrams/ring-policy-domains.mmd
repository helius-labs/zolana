flowchart TB
    subgraph TOML["ring.toml, the operator's answers"]
        POL["[policy] table
        rules in row order, curator per list and cluster,
        entries_tree"]
    end
    subgraph CHAIN["On chain, accounts"]
        PC["PolicyConfig
        rules, sources, policy_hash,
        entries_tree, generation, generation_slot"]
        PDA["own namespace PDA
        signer, holds no data"]
        RING["ring program, one released binary
        ListId::writer() gates mutations, verify, CPI"]
    end
    subgraph TREES["SPP trees, one shared entry set"]
        REC["ListEntry UTXOs
        one lineage per list and member,
        own or a curator ring's"]
        ADDR["claimed addresses
        indexed nullifier tree"]
        ROOTS["state root, nullifier root"]
    end
    subgraph WALLET["Per transfer, wallet and prover"]
        SRC["rows trusted under the pinned hash,
        per list source resolution from the stored map"]
        POOLD["Answers, ANSWER_SLOTS slots
        proven answers to the rules"]
        PRF["one Groth16 proof
        reproduces policy_hash from the rows and the map,
        muxes each entry's owner from the map"]
    end

    POL -- "create_policy stores the rows and pins the hash, upgrade authority" --> PC
    POL -. "set_policy_rules replaces the rows, upgrade authority" .-> PC
    PC -. "set_policy_source re-points a list, config authority" .-> PC
    PC -- "stored policy_hash enters the public input" --> RING
    PDA -- "owns and signs mutations of own sourced lists" --> REC
    REC --- ADDR
    PC -- "names the tree, curator sources share it" --> TREES
    PC -- "rows and source map" --> SRC
    SRC --> POOLD
    ROOTS -- "Merkle paths" --> POOLD
    POOLD --> PRF
    PRF -- "public input binds policy_hash and both roots" --> RING
